import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns

# Carga de datos
yt_df = pd.read_csv("youtube_user_by_country_2025.csv")

# Definición de países LATAM
latam_countries = [
    "Argentina",
    "Bolivia",
    "Brazil",
    "Chile",
    "Colombia",
    "Costa Rica",
    "Dominican Republic",
    "Ecuador",
    "El Salvador",
    "Guatemala",
    "Honduras",
    "Mexico",
    "Nicaragua",
    "Panama",
    "Paraguay",
    "Peru",
    "Uruguay",
    "Venezuela",
]

# Filtrado y selección de variables
latam_df = yt_df[yt_df["country"].isin(latam_countries)].copy()

# Ordenamiento de datos
df_users = latam_df.sort_values(by="users_2024", ascending=True)
df_penetration = latam_df.sort_values(
    by="penetration_rate_2024", ascending=True
)

# Visualización comparativa
fig, axes = plt.subplots(1, 2, figsize=(16, 8))

# Gráfica 1: Usuarios totales
sns.barplot(
    ax=axes[0],
    data=df_users,
    x="users_2024",
    y="country",
    palette="Blues_r",
    hue="country",
    legend=False,
)
axes[0].set_title("Usuarios Totales de YouTube en LATAM (2024)", fontsize=14)
axes[0].set_xlabel("Usuarios (en millones)")
axes[0].set_ylabel("País")

# Gráfica 2: Tasa de penetración
sns.barplot(
    ax=axes[1],
    data=df_penetration,
    x="penetration_rate_2024",
    y="country",
    palette="Greens_r",
    hue="country",
    legend=False,
)
axes[1].set_title("Tasa de Penetración (%) de YouTube en LATAM", fontsize=14)
axes[1].set_xlabel("Penetración (%)")
axes[1].set_ylabel("")

plt.tight_layout()
plt.show()







import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns

# Carga y limpieza
yt_df = pd.read_csv("youtube_user_by_country_2025.csv")
whr_df = pd.read_csv("world_happiness_report_2024.csv")

# Estandarización de nombres clave para el JOIN
whr_df["Country name"] = whr_df["Country name"].replace(
    {
        "United States": "United States of America",
        "Czechia": "Czech Republic",
        "Taiwan Province of China": "Taiwan",
    }
)

# Unificación mediante INNER JOIN
merged_df = pd.merge(
    yt_df,
    whr_df,
    left_on="country",
    right_on="Country name",
    how="inner",
)

# Cálculo del coeficiente de correlación de Pearson y Spearman
corr_pearson = merged_df["penetration_rate_2024"].corr(
    merged_df["Ladder score"], method="pearson"
)
corr_spearman = merged_df["penetration_rate_2024"].corr(
    merged_df["Ladder score"], method="spearman"
)

# Scatter Plot con línea de tendencia
plt.figure(figsize=(10, 6))
sns.regplot(
    data=merged_df,
    x="penetration_rate_2024",
    y="Ladder score",
    scatter_kws={"alpha": 0.6, "color": "#1f77b4"},
    line_kws={"color": "red", "linewidth": 2},
)

plt.title("Relación entre Penetración de YouTube y Happiness Score", fontsize=14)
plt.xlabel("Tasa de Penetración de YouTube 2024 (%)", fontsize=12)
plt.ylabel("Puntaje de Felicidad (Ladder Score)", fontsize=12)
plt.grid(True, linestyle="--", alpha=0.5)
plt.show()

print(f"Coeficiente de Pearson: {corr_pearson:.4f}")
print(f"Coeficiente de Spearman: {corr_spearman:.4f}")









import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns
from sklearn.preprocessing import MinMaxScaler

# 1. Lectura de datos
yt_df = pd.read_csv("youtube_user_by_country_2025.csv")
whr_df = pd.read_csv("world_happiness_report_2024.csv")

# 2. Homogeneización y JOIN
df_advanced = pd.merge(
    yt_df,
    whr_df,
    left_on="country",
    right_on="Country name",
    how="inner",
)

# 3. Normalización con MinMaxScaler
scaler = MinMaxScaler()
cols_to_normalize = ["Ladder score", "Explained by: Log GDP per capita", "penetration_rate_2024"]
normalized_scaled = scaler.fit_transform(df_advanced[cols_to_normalize])

df_advanced["felicidad_norm"] = normalized_scaled[:, 0]
df_advanced["GDP_norm"] = normalized_scaled[:, 1]
df_advanced["penetracion_norm"] = normalized_scaled[:, 2]

# 4. Cálculo del Índice
df_advanced["indice_oportunidad"] = (
    df_advanced["felicidad_norm"] + df_advanced["GDP_norm"]
) - df_advanced["penetracion_norm"]

# Top 10 Mercados
top_10_potencial = df_advanced.sort_values(
    by="indice_oportunidad", ascending=False
).head(10)

# 5. Gráfica de Burbujas
plt.figure(figsize=(14, 9))

scatter = plt.scatter(
    x=df_advanced["Explained by: Log GDP per capita"],
    y=df_advanced["Ladder score"],
    s=df_advanced["users_2024"] / 1e5,  # Ajuste de escala para el tamaño
    c=df_advanced["penetration_rate_2024"],
    cmap="viridis",
    alpha=0.7,
    edgecolors="black",
    linewidth=0.8,
)

cbar = plt.colorbar(scatter)
cbar.set_label("Tasa de Penetración (%)")

# Anotaciones para el Top 10
for i, row in top_10_potencial.iterrows():
    plt.annotate(
        row["country"],
        (
            row["Explained by: Log GDP per capita"],
            row["Ladder score"],
        ),
        fontsize=9,
        fontweight="bold",
        xytext=(5, 5),
        textcoords="offset points",
    )

plt.title("Índice de Oportunidad Digital: PIB vs Felicidad", fontsize=15)
plt.xlabel("Log PIB per cápita (Contribución)", fontsize=12)
plt.ylabel("Puntaje de Felicidad (Ladder Score)", fontsize=12)
plt.grid(True, linestyle=":", alpha=0.6)
plt.show()

# Despliegue de resultados en consola
print(
    top_10_potencial[
        [
            "country",
            "indice_oportunidad",
            "users_2024",
            "penetration_rate_2024",
            "Ladder score",
        ]
    ].to_string(index=False)
)
